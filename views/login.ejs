<%- include('Templates/header', { title: 'Login', errorMessage: '' }) %>

    <div>
        <h1>Login Page</h1> 
        <form action="/loggingin" method="POST">
            <div class="mb-3">
                <label for="emailInput" class="form-label">Email address</label>
                <input type="email" class="form-control" name="email" id="emailInput" aria-describedby="emailHelp">
            </div>
            <div class="mb-3">
                <label for="passwordInput" class="form-label">Password</label>
                <input type="password" class="form-control" name="password" id="passwordInput">
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
        <p><%= errorMessage %></p>
        <button type="button" class="btn btn-primary" onclick="window.location.href='/signup'">Don't have an account? Sign up here</button>
    </div>

<%- include('Templates/footer') %>
